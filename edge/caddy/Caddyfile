# No TLS and no ACME. The Cloudflare edge terminates HTTPS near the visitor and
# cloudflared hands us plain HTTP on the Docker bridge, so there is nothing here
# to encrypt and nothing to redirect to.
#
# Caddy stays in the path rather than pointing cloudflared straight at the app
# because it owns the shared concerns: security headers, compression, and the
# per-site blocks that let one tunnel serve every project in this repo. Adding a
# site is a block here plus an ingress rule, not a second tunnel.
{
	auto_https off
	admin off
	servers {
		# Makes Caddy's own client_ip field resolve the real visitor rather
		# than cloudflared's bridge address.
		trusted_proxies static private_ranges
	}
}

(site) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		# reverse_proxy adds "Via: 1.1 Caddy", which announces the origin stack
		# and undoes the point of stripping Server just above it.
		-Via
	}

	encode zstd gzip

	# Off by default in Caddy 2, which is what left the tunnel test blind to
	# every request it served. On from the start here.
	log {
		output stderr
		format console
	}
}

# The sites. These were added alongside the next-* staging hostnames during the
# 2026-08-27 cutover so both answered and DNS alone decided which the public
# reached; the staging records were deleted once the flip was verified, so those
# blocks are gone with them.
http://isaacbythewood.com {
	import site
	reverse_proxy isaacbythewood-next:8000
}

http://blog.bythewood.me {
	import site
	reverse_proxy blog-next:8000
}

# The collector endpoint is cross-origin by design and is written to by every
# tracked site, so it is the one route in this repo an anonymous stranger can
# POST to. The app caps the body at 16KB itself; this is the second fence.
http://analytics.bythewood.me {
	import site

	request_body {
		max_size 16KB
	}

	reverse_proxy analytics-next:8000
}

http://status.bythewood.me {
	import site
	reverse_proxy status-next:8000
}

# The redirects the Linode's Caddy owns today.
#
# They are easy to forget because the `*.bythewood.me` and `*.isaacbythewood.com`
# wildcards currently answer for www without anything being configured for it.
# Remove the wildcard at decommission and www stops resolving entirely unless
# these exist first.
#
# bythewood.me itself has never served a site. It redirects to the portfolio,
# and it is also the zone apex carrying the Google Workspace MX records, so the
# only thing changing here is where HTTP goes.
http://www.isaacbythewood.com {
	import site
	redir https://isaacbythewood.com{uri} permanent
}

http://bythewood.me, http://www.bythewood.me {
	import site
	redir https://isaacbythewood.com{uri} permanent
}

# Anything arriving without a matching Host did not come through an ingress
# rule. Say so rather than silently serving a site by accident.
:80 {
	log {
		output stderr
		format console
	}
	header -Server
	respond "orchard edge: no site block for this host" 404
}
