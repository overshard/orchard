# No TLS and no ACME. Cloudflare terminates HTTPS and cloudflared hands plain
# HTTP to the Docker bridge, so there is nothing here to encrypt.
#
# Caddy sits between cloudflared and the apps so headers, compression and
# per-host routing live in one place. Adding a site is a block here plus an
# ingress rule.
{
	auto_https off
	admin off
	servers {
		# Or client_ip resolves to cloudflared's bridge address.
		trusted_proxies static private_ranges
	}
}

# Split out from (site) so repos can import these without the blanket `encode`
# that its git wire must not have.
(headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		# reverse_proxy adds "Via: 1.1 Caddy", which undoes the line above.
		-Via
	}

	# Off by default in Caddy 2. Two loggers carry the same access events:
	# console is what `docker logs orchard-caddy` shows and stays the source
	# of truth, and ship is a copy for logging.bythewood.me.
	log console {
		output stderr
		format console
	}

	# Caddy cannot carry a Go handler, so it ships over its own net writer
	# rather than web/shipper.go. Only the access logs go, never Caddy's own
	# runtime log: the runtime log is where a failing net writer reports
	# itself, and shipping that over the connection that is failing is a
	# feedback loop. The access log is driven by requests instead.
	log ship {
		# soft_start, or Caddy refuses to boot whenever the logging site is
		# down. `make up` guarantees that case, since the edge starts first.
		output net tcp/orchard-logging:9001 {
			soft_start
		}

		# Headers are most of the bytes on the wire and the record they land
		# in caps attrs at 8KB anyway. cf_ray is the one worth keeping, and
		# log_append below puts it back as a field of its own.
		format filter {
			wrap json
			fields {
				request>headers delete
				request>tls delete
				resp_headers delete
			}
		}
	}

	# Read before the filter above drops the headers, so a row here can be
	# matched to the site's own row for the same request.
	log_append cf_ray {http.request.header.Cf-Ray}

	# Every app names the kind of route it served, and an edge row is its own
	# kind, so the log store can group by this without a hole where Caddy is.
	log_append component edge
}

# Exploit scanners probing software nothing here runs, about a third of all
# requests. Blocked at the edge because it is a property of the edge, not of any
# app, and because a third of every log record being hostile noise is what stops
# a real new 404 after a deploy from being visible at all.
#
# `respond 404` rather than `abort`: Cloudflare reads a closed origin connection
# as an origin error and counts it against origin health. A 404 is what these
# paths already returned.
#
# The same list also exists as a Cloudflare WAF rule, which catches these first
# and more cheaply. Keeping a copy here is the point, since a dashboard rule is
# not in version control and does not come back on a rebuild. One custom rule of
# the five the free plan allows, named "Exploit scanner paths", action Block,
# pasted identically into the bythewood.me and isaacbythewood.com zones:
#
#   (starts_with(http.request.uri.path, "/."))
#   or (http.host ne "repos.bythewood.me" and (
#         lower(http.request.uri.path) in {"/env" "/_environment"}
#      or lower(http.request.uri.path) contains "wp-"
#      or lower(http.request.uri.path) contains "wordpress"
#      or lower(http.request.uri.path) contains "/wp/"
#      or lower(http.request.uri.path) contains "xmlrpc"
#      or lower(http.request.uri.path) contains "phpmyadmin"
#      or lower(http.request.uri.path) contains "autodiscover"
#      or lower(http.request.uri.path) contains "/cgi-bin/"
#      or lower(http.request.uri.path) contains "/vendor/"
#      or lower(http.request.uri.path) contains ".env"
#      or lower(http.request.uri.path) contains "/.git"
#      or lower(http.request.uri.path) contains "/.aws"
#      or lower(http.request.uri.path) contains "/.ssh"
#      or lower(http.request.uri.path) contains "/.vscode"
#      or lower(http.request.uri.path) contains ".php"
#      or lower(http.request.uri.path) contains ".asp"
#      or lower(http.request.uri.path) contains ".jsp"
#      or lower(http.request.uri.path) contains ".cgi"
#      or lower(http.request.uri.path) contains ".axd"
#      or lower(http.request.uri.path) contains ".sql"
#      or lower(http.request.uri.path) contains ".bak"
#      or lower(http.request.uri.path) contains "phpinfo"
#      or lower(http.request.uri.path) contains "/actuator/"
#      or lower(http.request.uri.path) contains "/_profiler/"
#      or lower(http.request.uri.path) contains "/solr/"
#      or lower(http.request.uri.path) contains "/livewire/"
#      or lower(http.request.uri.path) contains "/sitecore/"
#      or lower(http.request.uri.path) contains "telerik"
#      or lower(http.request.uri.path) contains "id_rsa"
#      or lower(http.request.uri.path) contains "id_ed25519"
#      or lower(http.request.uri.path) contains "credentials.json"
#      or lower(http.request.uri.path) contains "service-account"
#      or lower(http.request.uri.path) contains "serviceaccount"
#      or lower(http.request.uri.path) contains "keyfile.json"
#      or lower(http.request.uri.path) contains "adminsdk"
#      or lower(http.request.uri.path) contains "-key.json"
#      or lower(http.request.uri.path) contains "-sa.json"
#      or lower(http.request.uri.path) contains "/sa.json"
#      or lower(http.request.uri.path) contains "/key.json"
#      or lower(http.request.uri.path) contains "/_ignition/"
#      or lower(http.request.uri.path) contains "/storage/logs/"
#      or lower(http.request.uri.path) contains "/webinterface/"
#      or lower(http.request.uri.path) contains "/zabbix/"
#      or lower(http.request.uri.path) contains "/owa/"
#      or lower(http.request.uri.path) contains "/boaform/"
#      or lower(http.request.uri.path) contains "/jenkins/"
#      or lower(http.request.uri.path) contains "/hudson/"
#      or lower(http.request.uri.path) contains "sugar_version.json"
#      or lower(http.request.uri.path) contains "com_pagebuilderck"
#      or lower(http.request.uri.path) contains "/login.do"
#      or lower(http.request.uri.path) contains "/showlogin.cc"
#   ))
#
# The first line sits outside the host test so it covers repos as well. Nothing
# here serves a path starting with a dot and no site registers a .well-known
# route, so it cannot reach repository content, which is always under
# /{name}/{blob|raw|tree|commit}/.
#
# "/.git" keeps its leading slash, and so do "/.aws", "/.ssh" and "/.vscode". A
# bare ".git" matches /orchard.git/info/refs and takes clone and push over
# HTTPS down with it.
#
# ".env" is bare on purpose, which is what catches /app.env and /docker.env, and
# it is only safe because the host test above excludes repos.
#
# Do not turn on Bot Fight Mode to solve this. status probes its own public
# hostnames with a plain Go client, which cannot solve a JS challenge, so every
# site here would report a permanent false outage.

# repos.bythewood.me serves arbitrary paths out of arbitrary repositories, so
# matching on path content collides with real files: it took
# /orchard/blob/main/sites/analytics.bythewood.me/.env.example off the file
# browser, and every site here has to commit a .env.example.
#
# Depth is the wrong separator for that. Anchoring at the root gave up
# everything below the first slash, and scanners walk /var/www/.git/config and
# /api/.env/.git/config all day. Repository content always carries a verb as its
# second segment, so exempting that shape and applying the full list everywhere
# else keeps the browser working and still catches the nested probes.
#
# /orchard.git/info/refs is not exempt and must not match, which is why every
# dotfile clause keeps its leading slash. Clone and push over HTTPS depend on it.
(scanners_repos) {
	@hostile_repos {
		not path_regexp repo_content ^/[^/]+/(?:blob|raw|tree|commit|log|archive|branches|tags)(?:/|$)
		path_regexp hostile_repos (?i)(?:^|/)(?:wp-|wordpress|wp/|xmlrpc|phpmyadmin|autodiscover|cgi-bin/|vendor/|actuator/|_profiler/|solr/|livewire/|sitecore/|_ignition/|storage/logs/|webinterface/|zabbix/|owa/|boaform/|jenkins/|hudson/|sa\.json|key\.json|\.git|\.aws|\.ssh|\.vscode)|telerik|phpinfo|id_rsa|id_ed25519|credentials\.json|keyfile\.json|adminsdk|-key\.json|-sa\.json|sugar_version\.json|com_pagebuilderck|login\.do|showlogin\.cc|service-?account|\.env|\.(?:php|asp|jsp|cgi|axd|sql|bak)|^/(?:env|_environment)$
	}

	log_skip @hostile_repos

	handle @hostile_repos {
		# A header-less response lets Cloudflare stamp its own TTL and hold
		# the 404 at the edge.
		header Cache-Control "no-store"
		respond 404
	}
}

(scanners) {
	# Matched anywhere in the path rather than at the root, since most of the
	# volume arrives nested under a guessed prefix (/blog/wp-json/, /app/.env).
	# Ordinary 404s like /login or /apple-touch-icon.png are left alone.
	@hostile path_regexp hostile (?i)(?:^|/)(?:wp-|wordpress|wp/|xmlrpc|phpmyadmin|autodiscover|cgi-bin/|vendor/|actuator/|_profiler/|solr/|livewire/|sitecore/|_ignition/|storage/logs/|webinterface/|zabbix/|owa/|boaform/|jenkins/|hudson/|sa\.json|key\.json|\.git|\.aws|\.ssh|\.vscode)|telerik|phpinfo|id_rsa|id_ed25519|credentials\.json|keyfile\.json|adminsdk|-key\.json|-sa\.json|sugar_version\.json|com_pagebuilderck|login\.do|showlogin\.cc|service-?account|\.env|\.(?:php|asp|jsp|cgi|axd|sql|bak)|^/(?:env|_environment)$

	# Not logged. Moving the noise to another log is not the point.
	log_skip @hostile

	handle @hostile {
		header Cache-Control "no-store"
		respond 404
	}
}

(site) {
	import scanners
	import headers

	encode zstd gzip
}

# One block per hostname, each proxying to a container by name.
http://isaacbythewood.com {
	import site
	reverse_proxy orchard-isaacbythewood:8000
}

http://blog.bythewood.me {
	import site
	reverse_proxy orchard-blog:8000
}

# The collector is the one route here an anonymous stranger can POST to. The app
# caps the body at 16KB itself, and this is the second fence.
http://analytics.bythewood.me {
	import site

	request_body {
		max_size 16KB
	}

	reverse_proxy orchard-analytics:8000
}

# /verify is answered here rather than proxied, so reaching it really does mean
# being inside the network. The other sites call orchard-auth:8000/verify by
# container name and never come through Caddy at all.
#
# The login form is the one page here a stranger can reach. What bounds the abuse
# is in the app: one outstanding code at a time and a per account ceiling that
# ignores the source address, since a per-IP limit is bypassed by sending one
# request from each of a thousand proxies.
http://auth.bythewood.me {
	import site

	# The wildcard catches /verify/ too.
	handle /verify* {
		respond "not here" 404
	}

	handle {
		reverse_proxy orchard-auth:8000
	}
}

http://status.bythewood.me {
	import site
	reverse_proxy orchard-status:8000
}

# /ingest and /aggregate are answered here rather than proxied, so reaching
# either really does mean being inside the network. Every site posts to
# orchard-logging:8000 by container name and never comes through Caddy at all,
# and dash reads /aggregate the same way.
http://logging.bythewood.me {
	import site

	# Two handle blocks so the order is stated rather than inherited from
	# Caddy's directive ordering. The wildcards catch /ingest/ too.
	handle /ingest* {
		respond "not here" 404
	}

	handle /aggregate* {
		respond "not here" 404
	}

	handle {
		reverse_proxy orchard-logging:8000
	}
}

# The live panels arrive over server-sent events, which must not be buffered or
# compressed on the way out, so this imports the two halves of (site) directly
# and gives encode a matcher instead of taking the blanket one.
http://dash.bythewood.me {
	import scanners
	import headers

	@compressible not path /events

	encode @compressible zstd gzip

	reverse_proxy orchard-dash:8000
}

# ntfy, the alert path. An allowlist of three routes, for two reasons.
#
# ntfy publishes over GET as well as POST, so a denylist leaks: /<topic>/publish,
# /<topic>/send and /<topic>/trigger all publish with no body, and a POST to /
# publishes with the topic in a JSON body. All four were confirmed against the
# running container.
#
# And everything else ntfy serves is surface nothing here needs. The three below
# are the complete set the Android client uses, read off this proxy's own access
# log. The web app is separately off in server.yml.
#
# ntfy's own deny-all auth is the fence that matters. This is the second one, so
# even a stolen write token cannot publish from out here.
http://ntfy.bythewood.me {
	import site

	# Commas allowed, since the client subscribes to "status,logging" as one
	# path segment rather than opening two connections.
	@client {
		method GET
		path_regexp ^/[A-Za-z0-9_,-]+/(ws|json|sse|raw|auth)$
	}

	handle @client {
		reverse_proxy orchard-ntfy:8000
	}

	handle {
		respond "not here" 404
	}
}

# repos, the git remote. 100MB is Cloudflare's own ceiling on a proxied request
# body for Free and Pro, which nothing here can raise, because a tunnel hostname
# must stay proxied. Stating it means an oversized push is refused here with a
# 413 that names the limit rather than by Cloudflare with one that does not.
http://repos.bythewood.me {
	# Not `import site`, because packfiles are already compressed and gzipping
	# one costs CPU on both ends to make it slightly larger. `encode` goes on
	# the browse handle instead.
	import scanners_repos
	import headers

	@git path_regexp ^/[^/]+\.git(/.*)?$

	handle @git {
		request_body {
			max_size 100MB
		}
		reverse_proxy orchard-repos:8000
	}

	# The browse UI is ordinary HTML and does want compression.
	handle {
		encode zstd gzip
		reverse_proxy orchard-repos:8000
	}
}

# bythewood.me has never served a site. It is the zone apex carrying the MX
# records, so all that is decided here is where HTTP goes.
http://www.isaacbythewood.com {
	import site

	# Wrapped in a handle so it is ordered against the scanner block rather
	# than ahead of it. Caddy sorts redir before handle, so a bare redir here
	# answers a scanner with a 301 and the block above never runs.
	handle {
		redir https://isaacbythewood.com{uri} permanent
	}
}

http://bythewood.me, http://www.bythewood.me {
	import site

	# See www.isaacbythewood.com above.
	handle {
		redir https://isaacbythewood.com{uri} permanent
	}
}

# No matching Host means it did not come through an ingress rule. Say so rather
# than serving a site by accident.
#
# Only one logger here, and it has to be the console one. A block with no host
# matcher becomes the server's default_logger_name, which is a single string
# rather than a list, so naming two loggers silently keeps one and drops the
# other. Everything reaching a real hostname is logged both ways above, and
# these 404s stay where they already were.
:80 {
	log console {
		output stderr
		format console
	}
	header -Server
	respond "orchard edge: no site block for this host" 404
}
