# No TLS and no ACME. The Cloudflare edge terminates HTTPS near the visitor and
# cloudflared hands plain HTTP to the Docker bridge, so there is nothing here to
# encrypt and nothing to redirect to.
#
# Caddy stays in the path rather than cloudflared pointing straight at each app,
# because it owns the shared concerns: security headers, compression, and the
# per-site blocks that let one tunnel serve every project here. Adding a site is
# a block here plus an ingress rule, not a second tunnel.
{
	auto_https off
	admin off
	servers {
		# Makes Caddy's own client_ip field resolve the real visitor rather
		# than cloudflared's bridge address.
		trusted_proxies static private_ranges
	}
}

(site) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		# reverse_proxy adds "Via: 1.1 Caddy", which announces the origin
		# stack and undoes the Server header stripped just above.
		-Via
	}

	encode zstd gzip

	# Access logging is off by default in Caddy 2.
	log {
		output stderr
		format console
	}
}

# The sites. One block per hostname, each proxying to a container by name on
# the shared network.
http://isaacbythewood.com {
	import site
	reverse_proxy orchard-isaacbythewood:8000
}

http://blog.bythewood.me {
	import site
	reverse_proxy orchard-blog:8000
}

# The collector endpoint is cross-origin by design and written to by every
# tracked site, so it is the one route here an anonymous stranger can POST to.
# The app caps the body at 16KB itself; this is the second fence.
http://analytics.bythewood.me {
	import site

	request_body {
		max_size 16KB
	}

	reverse_proxy orchard-analytics:8000
}

http://status.bythewood.me {
	import site
	reverse_proxy orchard-status:8000
}

# Redirects. bythewood.me has never served a site: it redirects to the
# portfolio, and it is also the zone apex carrying the MX records, so the only
# thing decided here is where HTTP goes.
http://www.isaacbythewood.com {
	import site
	redir https://isaacbythewood.com{uri} permanent
}

http://bythewood.me, http://www.bythewood.me {
	import site
	redir https://isaacbythewood.com{uri} permanent
}

# Anything arriving without a matching Host did not come through an ingress
# rule. Say so rather than serving a site by accident.
:80 {
	log {
		output stderr
		format console
	}
	header -Server
	respond "orchard edge: no site block for this host" 404
}
