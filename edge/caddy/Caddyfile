# No TLS and no ACME. Cloudflare terminates HTTPS and cloudflared hands plain
# HTTP to the Docker bridge, so there is nothing here to encrypt.
#
# Caddy sits between cloudflared and the apps so headers, compression and
# per-host routing live in one place. Adding a site is a block here plus an
# ingress rule.
{
	auto_https off
	admin off
	servers {
		# Or client_ip resolves to cloudflared's bridge address.
		trusted_proxies static private_ranges

		# Only Cloudflare can set this one. Without it client_ip comes out of
		# X-Forwarded-For, which the client sends, so a scanner claiming to be
		# 127.0.0.1 is logged as 127.0.0.1 and hides from the direct-hits panel
		# on logging that exists to catch requests which skipped Cloudflare.
		client_ip_headers Cf-Connecting-Ip
	}
}

# Split out from (site) so repos can import these without the blanket `encode`
# that its git wire must not have.
(headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		# reverse_proxy adds "Via: 1.1 Caddy", which undoes the line above.
		-Via
	}

	# Off by default in Caddy 2. Two loggers carry the same access events:
	# console is what `docker logs orchard-caddy` shows and stays the source
	# of truth, and ship is a copy for logging.bythewood.me.
	log console {
		output stderr
		format console
	}

	# Caddy cannot carry a Go handler, so it ships over its own net writer
	# rather than web/shipper.go. Only the access logs go, never Caddy's own
	# runtime log: the runtime log is where a failing net writer reports
	# itself, and shipping that over the connection that is failing is a
	# feedback loop. The access log is driven by requests instead.
	log ship {
		# soft_start, or Caddy refuses to boot whenever the logging site is
		# down. `make up` guarantees that case, since the edge starts first.
		output net tcp/orchard-logging:9001 {
			soft_start
		}

		# Headers are most of the bytes on the wire and the record they land
		# in caps attrs at 8KB anyway. cf_ray is the one worth keeping, and
		# log_append below puts it back as a field of its own.
		format filter {
			wrap json
			fields {
				request>headers delete
				request>tls delete
				resp_headers delete
			}
		}
	}

	# Read before the filter above drops the headers, so a row here can be
	# matched to the site's own row for the same request.
	log_append cf_ray {http.request.header.Cf-Ray}

	# Every app names the kind of route it served, and an edge row is its own
	# kind, so the log store can group by this without a hole where Caddy is.
	log_append component edge
}

# Exploit scanners probing software nothing here runs, about a third of all
# requests. Blocked at the edge because it is a property of the edge rather than
# of any app, and because a third of every log record being hostile noise is what
# stops a real new 404 after a deploy from being visible at all.
#
# `respond 404` rather than `abort`: Cloudflare reads a closed origin connection
# as an origin error and counts it against origin health. A 404 is what these
# paths already returned.
#
# The same list exists at Cloudflare, which catches these first and more cheaply.
# Those four rules are in cloudflare-rules.txt beside this file, since a
# dashboard rule is not in version control.
#
# Some of these clauses look wrong and are not.
#
#   "/.git", "/.aws", "/.ssh" and "/.vscode" keep the leading slash. A bare
#   ".git" matches /orchard.git/info/refs and takes clone and push over HTTPS
#   down with it.
#
#   "graphql", "stripe" and "firebase" are bare substrings, which is only safe
#   because repos is exempt by the content shape. Anything matching one of those
#   words is a product nothing here runs.
#
#   ".env" is bare, which catches /app.env and /docker.env, and it is only safe
#   because repos is excluded above.
#
#   "/media/system/" carries the system segment. blog serves /media/images/ and
#   /media/avatar_images/ for real.
#
#   "Dockerfile" is end-anchored because one of the mirrored repositories is
#   named dockerfiles, and a bare substring took /dockerfiles and its atom feed
#   off repos.
#
#   The archive extensions are end-anchored and repos is excluded from them,
#   since repos serves /{name}/archive/{rev}.tar.gz for real.
#
#   The config and secrets filename groups are capped at two path segments. A
#   hashed asset lands under /static/ and an unanchored config\.js would take
#   one of them down.
#
# Rule 1's first line at Cloudflare sits outside the repos guard, so it covers
# repos too. Nothing here serves a path starting with a dot and no site registers
# a .well-known route, so it cannot reach repository content. Adding one means
# changing that rule first, since Cloudflare blocks it before Caddy sees it.
#
# Everything generic stays out. /info, /console, /new/, /old/ and /backup/ are
# all plausible routes here one day and each is worth a cheap 404, and /code is
# already a real route on isaacbythewood.com.
#
# Do not turn on Bot Fight Mode to solve this. status probes its own public
# hostnames with a plain Go client, which cannot solve a JS challenge, so every
# site here would report a permanent false outage.

# repos.bythewood.me serves arbitrary paths out of arbitrary repositories, so
# matching on path content collides with real files: it took
# /orchard/blob/main/sites/analytics.bythewood.me/.env.example off the file
# browser, and every site here has to commit a .env.example.
#
# Depth is the wrong separator for that, since scanners walk /var/www/.git/config
# and /api/.env/.git/config all day. Repository content always carries a verb as
# its second segment, so exempting that shape and applying the full list
# everywhere else keeps the browser working and still catches the nested probes.
#
# /orchard.git/info/refs is not exempt and must not match, which is why every
# dotfile clause keeps its leading slash. Clone and push over HTTPS depend on it.
(scanners_repos) {
	@hostile_repos {
		not path_regexp repo_content ^/[^/]+/(?:blob|raw|tree|commit|log|archive|branches|tags)(?:/|$)
		path_regexp hostile_repos (?i)(?:^|/)(?:wp-|wordpress|wp/|xmlrpc|phpmyadmin|autodiscover|cgi-bin/|vendor/|actuator/|_profiler/|solr/|livewire/|sitecore/|_ignition/|storage/logs/|webinterface/|zabbix/|owa/|boaform/|jenkins/|hudson/|sa\.json|key\.json|\.git|\.aws|\.ssh|\.vscode|remote/fgt_lang|remote/login|global-protect/|ssl-vpn/|app/rest/|blade-auth/|blade-system/|pimcore-studio/|php-cgi/|administrator/|language/en-gb/|media/system/|api/v1/totp/|_cat/|_cluster/|_watcher/|_snapshot/|_nodes|api/datasources|api/alert-notifications|api/v1/provisioning/|api/org|api/dashboards|api/2\.0/mlflow/|containers/json|v1\.24/|images/json|v2/keys/|api/contents|auth/v1/|rest/v1/|api/v1/validate/code|api/v1/auto_login|druid/|hazelcast/|geoserver/|ws/v1/cluster|editor/filemanager/|plugins/editors/|media/jui/|@fs/|__vite_rsc_|@vite/|proc/self/|userfiles|read-document|inngest|api/fs/exec|api/exec|api/designer/|api/templates/preview|_debugbar/|_debug_toolbar/|__debug__/|debug/pprof|debug/vars|debug-kit|telescope/requests|server-status|server-info|nginx_status|graphql|actuator|swagger|openapi\.json|_payload\.json|app/etc/local\.xml|_darcs/|CVS/Root|stripe|firebase|amplifyconfiguration|amplify_outputs|awsconfiguration|aws-exports|aws_credentials|google-services|gc-service|gcp-service|client_secrets?\.|terraform\.tfstate|terraform\.tfvars|serverless\.ya?ml|sam-template|vercel\.json|netlify\.toml|docker-compose\.|compose\.ya?ml|Dockerfile$|Dockerfile\.|rclone\.conf|web\.config|gradle\.properties|application\.properties|bootstrap\.(?:yml|properties)|appsettings|settings\.py|secret_token|master\.key|schema\.prisma|composer\.(?:json|lock)|Gemfile|Rakefile|Jakefile|behat\.yml|circle\.yml|codeception\.yml|renovate\.json|platformio\.ini)|telerik|phpinfo|id_rsa|id_ed25519|credentials\.json|keyfile\.json|adminsdk|-key\.json|-sa\.json|sugar_version\.json|com_pagebuilderck|login\.do|showlogin\.cc|service-?account|\.env|joomla|keys-status|\.(?:php|asp|jsp|cgi|axd|sql|bak|esp|action)|\.(?:zip|rar|7z|tgz|tar\.gz)$|^/(?:env|_environment)$|\.astro\.mjs\.map$|\.(?:pem|key|p12|pfx|jks|keystore)$|^/(?:api/)?(?:proxy|fetch|redirect|request|url|webhook|load|out)$|^/(?:ip|null)$|^/(?:[^/]+/){0,2}_{0,2}env(?:-config)?\.(?:js|json|ts|txt|ya?ml|old)$|^/(?:[^/]+/){0,2}config(?:uration)?\.(?:json|js|ts|py|rb|ya?ml|toml|sh)$|^/(?:[^/]+/){0,2}(?:secrets?|credentials?|app-config|service_account|auth|token)\.(?:json|js|ts|py|rb|ya?ml|ini|csv|txt)$|^/config/[^/]*\.(?:ya?ml|json|exs|rb|conf|properties)$|^/(?:[^/]+/){0,2}(?:id_dsa|id_ecdsa|private-?key|privatekey)(?:$|\.)|^/api/(?:v\d+/)?(?:config|settings|keys|env|sysConfig)(?:/|$)|^/api/(?:session/properties|postman\.json)$|^/(?:s3/)?credentials$|^/s3\.(?:key|secret|ya?ml|properties)$
	}

	log_skip @hostile_repos

	handle @hostile_repos {
		# A header-less response lets Cloudflare stamp its own TTL and hold
		# the 404 at the edge.
		header Cache-Control "no-store"
		respond 404
	}
}

(scanners) {
	# Matched anywhere in the path rather than at the root, since most of the
	# volume arrives nested under a guessed prefix (/blog/wp-json/, /app/.env).
	# Ordinary 404s like /login or /apple-touch-icon.png are left alone.
	@hostile path_regexp hostile (?i)(?:^|/)(?:wp-|wordpress|wp/|xmlrpc|phpmyadmin|autodiscover|cgi-bin/|vendor/|actuator/|_profiler/|solr/|livewire/|sitecore/|_ignition/|storage/logs/|webinterface/|zabbix/|owa/|boaform/|jenkins/|hudson/|sa\.json|key\.json|\.git|\.aws|\.ssh|\.vscode|remote/fgt_lang|remote/login|global-protect/|ssl-vpn/|app/rest/|blade-auth/|blade-system/|pimcore-studio/|php-cgi/|administrator/|language/en-gb/|media/system/|api/v1/totp/|_cat/|_cluster/|_watcher/|_snapshot/|_nodes|api/datasources|api/alert-notifications|api/v1/provisioning/|api/org|api/dashboards|api/2\.0/mlflow/|containers/json|v1\.24/|images/json|v2/keys/|api/contents|auth/v1/|rest/v1/|api/v1/validate/code|api/v1/auto_login|druid/|hazelcast/|geoserver/|ws/v1/cluster|editor/filemanager/|plugins/editors/|media/jui/|@fs/|__vite_rsc_|@vite/|proc/self/|userfiles|read-document|inngest|api/fs/exec|api/exec|api/designer/|api/templates/preview|_debugbar/|_debug_toolbar/|__debug__/|debug/pprof|debug/vars|debug-kit|telescope/requests|server-status|server-info|nginx_status|graphql|actuator|swagger|openapi\.json|_payload\.json|app/etc/local\.xml|_darcs/|CVS/Root|stripe|firebase|amplifyconfiguration|amplify_outputs|awsconfiguration|aws-exports|aws_credentials|google-services|gc-service|gcp-service|client_secrets?\.|terraform\.tfstate|terraform\.tfvars|serverless\.ya?ml|sam-template|vercel\.json|netlify\.toml|docker-compose\.|compose\.ya?ml|Dockerfile$|Dockerfile\.|rclone\.conf|web\.config|gradle\.properties|application\.properties|bootstrap\.(?:yml|properties)|appsettings|settings\.py|secret_token|master\.key|schema\.prisma|composer\.(?:json|lock)|Gemfile|Rakefile|Jakefile|behat\.yml|circle\.yml|codeception\.yml|renovate\.json|platformio\.ini)|telerik|phpinfo|id_rsa|id_ed25519|credentials\.json|keyfile\.json|adminsdk|-key\.json|-sa\.json|sugar_version\.json|com_pagebuilderck|login\.do|showlogin\.cc|service-?account|\.env|joomla|keys-status|\.(?:php|asp|jsp|cgi|axd|sql|bak|esp|action)|\.(?:zip|rar|7z|tgz|tar\.gz)$|^/(?:env|_environment)$|\.astro\.mjs\.map$|\.(?:pem|key|p12|pfx|jks|keystore)$|^/(?:api/)?(?:proxy|fetch|redirect|request|url|webhook|load|out)$|^/(?:ip|null)$|^/(?:[^/]+/){0,2}_{0,2}env(?:-config)?\.(?:js|json|ts|txt|ya?ml|old)$|^/(?:[^/]+/){0,2}config(?:uration)?\.(?:json|js|ts|py|rb|ya?ml|toml|sh)$|^/(?:[^/]+/){0,2}(?:secrets?|credentials?|app-config|service_account|auth|token)\.(?:json|js|ts|py|rb|ya?ml|ini|csv|txt)$|^/config/[^/]*\.(?:ya?ml|json|exs|rb|conf|properties)$|^/(?:[^/]+/){0,2}(?:id_dsa|id_ecdsa|private-?key|privatekey)(?:$|\.)|^/api/(?:v\d+/)?(?:config|settings|keys|env|sysConfig)(?:/|$)|^/api/(?:session/properties|postman\.json)$|^/(?:s3/)?credentials$|^/s3\.(?:key|secret|ya?ml|properties)$

	# Not logged. Moving the noise to another log is not the point.
	log_skip @hostile

	handle @hostile {
		header Cache-Control "no-store"
		respond 404
	}
}

(site) {
	import scanners
	import headers

	encode zstd gzip
}

# One block per hostname, each proxying to a container by name.
http://isaacbythewood.com {
	import site
	reverse_proxy orchard-isaacbythewood:8000
}

http://blog.bythewood.me {
	import site
	reverse_proxy orchard-blog:8000
}

# The collector is the one route here an anonymous stranger can POST to. The app
# caps the body at 16KB itself, and this is the second fence.
http://analytics.bythewood.me {
	import site

	request_body {
		max_size 16KB
	}

	reverse_proxy orchard-analytics:8000
}

# /verify is answered here rather than proxied, so reaching it really does mean
# being inside the network. The other sites call orchard-auth:8000/verify by
# container name and never come through Caddy at all.
#
# The login form is the one page here a stranger can reach. What bounds the abuse
# is in the app: one outstanding code at a time and a per account ceiling that
# ignores the source address, since a per-IP limit is bypassed by sending one
# request from each of a thousand proxies.
http://auth.bythewood.me {
	import site

	# The wildcard catches /verify/ too.
	handle /verify* {
		respond "not here" 404
	}

	handle {
		reverse_proxy orchard-auth:8000
	}
}

http://status.bythewood.me {
	import site
	reverse_proxy orchard-status:8000
}

# Nothing here is public, so the site answers the login redirect itself and there
# is no path to carve out at the edge the way logging and auth need.
http://house.bythewood.me {
	import site
	reverse_proxy orchard-house:8000
}

# /ingest and /aggregate are answered here rather than proxied, so reaching
# either really does mean being inside the network. Every site posts to
# orchard-logging:8000 by container name and never comes through Caddy at all,
# and dash reads /aggregate the same way.
http://logging.bythewood.me {
	import site

	# Two handle blocks so the order is stated rather than inherited from
	# Caddy's directive ordering. The wildcards catch /ingest/ too.
	handle /ingest* {
		respond "not here" 404
	}

	handle /aggregate* {
		respond "not here" 404
	}

	handle {
		reverse_proxy orchard-logging:8000
	}
}

# The live panels arrive over server-sent events, which must not be buffered or
# compressed on the way out, so this imports the two halves of (site) directly
# and gives encode a matcher instead of taking the blanket one.
http://dash.bythewood.me {
	import scanners
	import headers

	@compressible not path /events

	encode @compressible zstd gzip

	reverse_proxy orchard-dash:8000
}

# The answer arrives over server-sent events, which must not be buffered or
# compressed, so this block imports scanners and headers directly rather than
# taking (site) with its blanket encode. Same reason dash does.
# Streams its answers and runs a local model, so the same shape as search: no
# blanket encode over the event stream and timeouts that outlast a slow turn.
http://chat.bythewood.me {
	import scanners
	import headers

	@compressible not path /api/send

	encode @compressible zstd gzip

	# A turn can call tools for several rounds before it answers, and the whole
	# of it is one held open response.
	reverse_proxy orchard-chat:8000 {
		flush_interval -1
		transport http {
			response_header_timeout 15m
			read_timeout 16m
		}
	}
}

# The model gateway. Every other site reaches it by container name on the
# bridge, so this hostname exists for the machines that are not on it.
http://llm.bythewood.me {
	import scanners
	import headers

	@compressible not path /v1/chat/completions

	encode @compressible zstd gzip

	reverse_proxy orchard-llm:8000 {
		flush_interval -1
		transport http {
			response_header_timeout 15m
			read_timeout 16m
		}
	}
}

http://search.bythewood.me {
	import scanners
	import headers

	@compressible not path /stream

	encode @compressible zstd gzip

	# A question runs a local model and can take a minute, well past Caddy's
	# default. The stream is held open for the whole of it.
	reverse_proxy orchard-search:8000 {
		flush_interval -1
		transport http {
			response_header_timeout 5m
			read_timeout 6m
		}
	}
}

# ntfy, the alert path. An allowlist of three routes, for two reasons.
#
# ntfy publishes over GET as well as POST, so a denylist leaks: /<topic>/publish,
# /<topic>/send and /<topic>/trigger all publish with no body, and a POST to /
# publishes with the topic in a JSON body. All four were confirmed against the
# running container.
#
# And everything else ntfy serves is surface nothing here needs. The three below
# are the complete set the Android client uses, read off this proxy's own access
# log. The web app is separately off in server.yml.
#
# ntfy's own deny-all auth is the fence that matters. This is the second one, so
# even a stolen write token cannot publish from out here.
http://ntfy.bythewood.me {
	import site

	# Commas allowed, since the client subscribes to "status,logging" as one
	# path segment rather than opening two connections.
	@client {
		method GET
		path_regexp ^/[A-Za-z0-9_,-]+/(ws|json|sse|raw|auth)$
	}

	handle @client {
		reverse_proxy orchard-ntfy:8000
	}

	handle {
		respond "not here" 404
	}
}

# repos, the git remote. 100MB is Cloudflare's own ceiling on a proxied request
# body for Free and Pro, which nothing here can raise, because a tunnel hostname
# must stay proxied. Stating it means an oversized push is refused here with a
# 413 that names the limit rather than by Cloudflare with one that does not.
http://repos.bythewood.me {
	# Not `import site`, because packfiles are already compressed and gzipping
	# one costs CPU on both ends to make it slightly larger. `encode` goes on
	# the browse handle instead.
	import scanners_repos
	import headers

	@git path_regexp ^/[^/]+\.git(/.*)?$

	handle @git {
		request_body {
			max_size 100MB
		}
		reverse_proxy orchard-repos:8000
	}

	# The browse UI is ordinary HTML and does want compression.
	handle {
		encode zstd gzip
		reverse_proxy orchard-repos:8000
	}
}

# bythewood.me has never served a site. It is the zone apex carrying the MX
# records, so all that is decided here is where HTTP goes.
http://www.isaacbythewood.com {
	import site

	# Wrapped in a handle so it is ordered against the scanner block rather
	# than ahead of it. Caddy sorts redir before handle, so a bare redir here
	# answers a scanner with a 301 and the block above never runs.
	handle {
		redir https://isaacbythewood.com{uri} permanent
	}
}

http://bythewood.me, http://www.bythewood.me {
	import site

	# See www.isaacbythewood.com above.
	handle {
		# The apex has never served a site, so carrying {uri} across bought
		# nothing and doubled every hostile path the block above misses: a
		# scanner probes here, takes the 301, and the same 404 is counted
		# twice. /blog is the one path people really guess at, and it was
		# the largest single 4xx on the system going to isaacbythewood.com
		# to 404 there.
		@blog path /blog /blog/*
		handle @blog {
			redir https://blog.bythewood.me/ permanent
		}
		handle {
			redir https://isaacbythewood.com/ permanent
		}
	}
}

# No matching Host means it did not come through an ingress rule. Say so rather
# than serving a site by accident.
#
# Only one logger here, and it has to be the console one. A block with no host
# matcher becomes the server's default_logger_name, which is a single string
# rather than a list, so naming two loggers silently keeps one and drops the
# other. Everything reaching a real hostname is logged both ways above, and
# these 404s stay where they already were.
:80 {
	log console {
		output stderr
		format console
	}
	header -Server
	respond "orchard edge: no site block for this host" 404
}
