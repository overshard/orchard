# The build context is this directory. Each site is its own Go module and
# carries its own copy of web/, so nothing above this folder is needed.
#
# Base images are pinned by digest, not only by tag: `oven/bun:1-alpine` floats
# across an entire major version, so two builds a month apart would not build
# the same thing. Bump these the same way the typst pin below is bumped.

# --- typst --------------------------------------------------------------
# The PDF compiler, pinned by version and verified by hash.
#
# It runs here, at build time, rather than on the request path. Posts load once
# at startup and cannot change while the process runs, so every PDF the site
# will ever serve is known before it boots. Compiling them now costs a second,
# keeps typst out of the runtime image, and turns the PDF route into serving a
# file.
FROM alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40 AS typst
ARG TYPST_VERSION=0.14.0
ARG TYPST_SHA256=99816d2982de08d2b091bac56b59b2faa523a10e1378ad3cdd68e35b8eb74b3d
RUN apk add --no-cache curl tar xz && \
    curl -fsSL -o /tmp/typst.tar.xz \
      "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz" && \
    echo "${TYPST_SHA256}  /tmp/typst.tar.xz" | sha256sum -c - && \
    tar -xJf /tmp/typst.tar.xz -C /tmp && \
    mv /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst

# --- frontend -----------------------------------------------------------
FROM oven/bun:1-alpine@sha256:07235578f79ef8c6f97d94aee7938e76f5cdba5f21ae5dbfdd3d3d38058437eb AS frontend
WORKDIR /src
# bunfig.toml comes with them: it sets install.peer = false, and it has to be
# present before install runs or the setting silently does nothing here while
# working locally.
COPY frontend/package.json frontend/bun.lock frontend/bunfig.toml ./
RUN bun install --frozen-lockfile
COPY frontend/ ./
RUN bun run build

# --- binary, PDFs and social cards --------------------------------------
FROM golang:1.27-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS build
WORKDIR /src

COPY --from=typst /usr/local/bin/typst /usr/local/bin/typst
# JetBrains Mono for code blocks; the other two are fallbacks. Typst embeds
# only DejaVu Sans Mono and its own serif, and falls back to a serif for
# anything it cannot find without saying so.
RUN apk add --no-cache font-jetbrains-mono ttf-dejavu ttf-liberation
# Geist, the body face for both the PDFs and the social cards, out of the same
# bun install that builds the frontend rather than a second download here.
# @fontsource ships woff2 only and Typst reads TrueType, so the package that
# works is Vercel's own, which carries the .ttf files.
COPY --from=frontend /src/node_modules/geist/dist/fonts/geist-sans /fonts/geist-sans

# The bracket glob makes go.sum optional. A module with no third party
# dependency has none for `go mod tidy` to write, and a plain `COPY go.sum`
# fails the build outright when the file is absent.
COPY go.mod go.su[m] ./
COPY web/ ./web/
COPY *.go ./
COPY templates/ ./templates/
# Typst resolves the absolute paths in the generated source (/typst/... and
# /content/images/...) against --typst-root, so the two directories have to sit
# under it with the names the source uses. content/ also has to be here before
# any compile at all, because main.go embeds it unconditionally.
COPY typst/ ./typst/
COPY content/ ./content/

# Two compiles, in a forced order. The PDFs and cards are generated by this
# same binary, so the generator cannot be the embedding build: build/pdfs and
# build/og do not exist yet, and //go:embed fails at compile time on a directory
# that is not there. A throwaway generator first, then the real one once its
# output is on disk.
RUN CGO_ENABLED=0 go build -o /generate .
RUN /generate -pdfs ./build/pdfs -og ./build/og -typst-root . -typst-fonts /fonts/geist-sans

# The Vite bundle joins them, and now everything the site serves is under
# build/ where the embed directives can see it.
COPY --from=frontend /build/dist ./build/dist
# Static, stripped, reproducible. CGO off is what makes FROM scratch possible,
# and -tags embed is what makes the image a single file.
RUN CGO_ENABLED=0 go build -tags embed -trimpath -ldflags="-s -w" \
    -o /app .

# --- image --------------------------------------------------------------
FROM scratch

# The whole blog. Templates, posts, the Vite bundle, every post PDF and every
# social card are inside the executable, so there is nothing to copy in beside
# it and none of the SITE_* variables to point anywhere.
COPY --from=build /app /app

# There is no /etc/passwd in a scratch image to name a user in, so this is the
# numeric UID:GID distroless calls "nonroot"; the kernel only needs the numbers.
# Nothing here writes to disk, so nothing has to be chown'd.
USER 65532:65532

# Docker cannot shell out to a health check in an image with no shell, so the
# binary probes itself. Compose sets the same check; this one makes the image
# describe its own liveness even when run without compose.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app", "-healthcheck"]

EXPOSE 8000
ENTRYPOINT ["/app"]
