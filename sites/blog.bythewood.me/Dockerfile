# Build context is this directory alone: the site is its own Go module with its
# own copy of web/. Base images are pinned by digest because :1-debian floats.

# Typst runs here at build time and never reaches the runtime image. Posts load
# once at startup and cannot change while the process runs, so every PDF the
# site will ever serve is known before it boots.
FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS typst
ARG TYPST_VERSION=0.14.0
ARG TYPST_SHA256=99816d2982de08d2b091bac56b59b2faa523a10e1378ad3cdd68e35b8eb74b3d
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates tar xz-utils && \
    rm -rf /var/lib/apt/lists/* && \
    curl -fsSL -o /tmp/typst.tar.xz \
      "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz" && \
    echo "${TYPST_SHA256}  /tmp/typst.tar.xz" | sha256sum -c - && \
    tar -xJf /tmp/typst.tar.xz -C /tmp && \
    mv /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst

FROM oven/bun:1-debian@sha256:923bedb355f7746666659f71e724998159a5c8c54bd1cb1030e1975a0698415b AS frontend
WORKDIR /src
# bunfig.toml has to arrive before install runs, or install.peer = false
# silently does nothing.
COPY frontend/package.json frontend/bun.lock frontend/bunfig.toml ./
RUN bun install --frozen-lockfile
COPY frontend/ ./
RUN bun run build

FROM golang:1.27-trixie@sha256:fbb7ae40b62ff8afe31662df570d39b4f5052ac32b90dae8e60d7657a20a74f4 AS build
WORKDIR /src

COPY --from=typst /usr/local/bin/typst /usr/local/bin/typst
# Typst embeds only DejaVu Sans Mono and its own serif, and falls back to a
# serif for anything it cannot find without saying so.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      fonts-jetbrains-mono fonts-dejavu fonts-liberation && \
    rm -rf /var/lib/apt/lists/*
# Geist out of the frontend stage's node_modules, because @fontsource ships
# woff2 only and Typst reads TrueType.
COPY --from=frontend /src/node_modules/geist/dist/fonts/geist-sans /fonts/geist-sans

# The bracket glob makes go.sum optional, since a plain COPY go.sum fails the
# build outright for a module with no third party dependency.
COPY go.mod go.su[m] ./
COPY web/ ./web/
COPY *.go ./
COPY templates/ ./templates/
# Typst resolves the absolute paths in the generated source (/typst/... and
# /content/images/...) against --typst-root, so both directories have to sit
# under it under the names the source uses.
COPY typst/ ./typst/
COPY content/ ./content/

# Two compiles, in a forced order. The PDFs and cards are generated by this same
# binary, so the generator cannot be the embedding build: //go:embed fails at
# compile time on build/pdfs and build/og before they exist.
RUN CGO_ENABLED=0 go build -o /generate .
RUN /generate -pdfs ./build/pdfs -og ./build/og -typst-root . -typst-fonts /fonts/geist-sans

COPY --from=frontend /build/dist ./build/dist
# CGO off is what makes FROM scratch possible, and -tags embed is what makes the
# image a single file.
RUN CGO_ENABLED=0 go build -tags embed -trimpath -ldflags="-s -w" \
    -o /app .

FROM scratch

# Templates, posts, the Vite bundle, every post PDF and every social card are
# inside the executable, so nothing else has to be copied in.
COPY --from=build /app /app

# There is no /etc/passwd in a scratch image to name a user in, so this is the
# bare numeric UID:GID. Nothing here writes to disk.
USER 65532:65532

# No shell in a scratch image for HEALTHCHECK to call, so the binary probes
# itself. Compose sets the same check.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app", "-healthcheck"]

EXPOSE 8000
ENV SHIP_LOGS=1
ENTRYPOINT ["/app"]
