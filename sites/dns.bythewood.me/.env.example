# A Cloudflare API token with Zone DNS Edit and Zone Read on bythewood.me. It
# writes the *.dns record and the TXT record that proves the DoT certificate.
# Without it DoH still works and the DoT front waits for a certificate.
CLOUDFLARE_TOKEN=

# Shared by the site and the DoT front, so nothing else on the bridge can ask
# through /internal/. make env fills it in.
DNS_BRIDGE_PASSWORD=

# Sent with every batch of log records shipped to logging.bythewood.me, which
# refuses a batch without it. The same value is in every .env, and `make
# logging-token` writes it.
LOGGING_TOKEN=
