# Claude answers every call when this is set. Leave it empty and set
# COMPOSE_PROFILES=local to run the model server on the card instead.
ANTHROPIC_API_KEY=
COMPOSE_PROFILES=
LLM_BUDGET=100
NTFY_TOKEN=

# Sent with every batch of log records shipped to logging.bythewood.me, which
# refuses a batch without it. The same value is in every .env, and `make
# logging-token` writes it.
LOGGING_TOKEN=
