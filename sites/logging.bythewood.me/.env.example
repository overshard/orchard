# Copy to .env in this directory and fill in. Compose reads .env from the
# project directory on its own, so nothing has to be exported in the shell and
# nothing is forwarded through the Makefile.
#
# .env is gitignored by bare name at any depth. This is a public repository:
# verify with `git check-ignore -v sites/logging.bythewood.me/.env`.

# The dashboard password. The app refuses to start without it rather than
# defaulting to something guessable.
LOGGING_PASSWORD=

# Write-only ntfy token for publishing silence and restart alerts, minted by
# `sh edge/setup-ntfy.sh token`. It can publish to the alert topics and can read
# nothing, so this is the least useful secret here to steal. Unset means alerts
# are logged and never delivered; the site still starts, because an alerter that
# cannot deliver must never stop the checks that noticed the outage.
NTFY_TOKEN=
