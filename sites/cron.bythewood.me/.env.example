# Written by make ntfy-token, so pushes to the reminders topic are allowed.
NTFY_TOKEN=
# Written by make cron-key, so prompt jobs can reach the model gateway.
LLM_KEY=

# Sent with every batch of log records shipped to logging.bythewood.me, which
# refuses a batch without it. The same value is in every .env, and `make
# logging-token` writes it.
LOGGING_TOKEN=
