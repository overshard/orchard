# Copy to .env in this directory and fill in. Compose reads .env from the
# project directory on its own, so nothing has to be exported in the shell and
# nothing is forwarded through the Makefile.
#
# .env is gitignored by bare name at any depth. This is a public repository:
# verify with `git check-ignore -v sites/repos.bythewood.me/.env`.

# Gates the web UI, which is where push tokens are minted and descriptions are
# edited. Browsing and cloning need no credential at all. The app refuses to
# start without this rather than defaulting to something guessable.
#
# It is also the session cookie signing key, derived rather than configured
# separately, so changing it signs every open session out.
REPOS_PASSWORD=

# Set to 0 to turn off the GitHub mirror lane. Useful for a dev run that should
# not clone 250MB before it serves a page. Anything else, including unset,
# leaves it on.
REPOS_MIRROR=
