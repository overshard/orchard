# The key dash uses to reach the model gateway at llm.bythewood.me, which
# writes the markets line and the TODAY summary four times a day. `make
# dash-key` mints one into this file. Left empty, the page runs and says the
# briefs are off.
LLM_KEY=

# Sent with every batch of log records shipped to logging.bythewood.me and with
# every read of its /aggregate, both refused without it. The same value is in
# every .env, and `make logging-token` writes it.
LOGGING_TOKEN=
