# The key chat uses to reach the model gateway at llm.bythewood.me.
#
# It is not generated by `make env`, because only llm.bythewood.me can mint one
# and it shows the plaintext exactly once. Sign in there, create a key named
# chat, and paste it here.
LLM_KEY=

# The FBI's Crime Data Explorer, which is what fills the crime figures on a
# property report. It is free and instant at https://api.data.gov/signup/ and it
# is the only key here `make env` cannot generate. Left empty, a report says it
# has no crime figures rather than guessing at them.
FBI_API_KEY=
