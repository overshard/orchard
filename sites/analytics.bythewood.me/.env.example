# `make env` from the repo root turns this into a .env with a generated password
# in it. Compose reads that .env from the project directory on its own, so
# nothing has to be exported in the shell or forwarded through the Makefile.
#
# .env is gitignored by bare name at any depth. This is a public repository:
# verify with `git check-ignore -v sites/analytics.bythewood.me/.env`.

# The dashboard password. The app refuses to start without it rather than
# defaulting to something guessable.
ANALYTICS_PASSWORD=
