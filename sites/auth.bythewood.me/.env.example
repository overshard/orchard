# `make env` from the repo root turns this into a .env. Compose reads that .env
# from the project directory on its own, so nothing has to be exported in the
# shell or forwarded through the Makefile.
#
# .env is gitignored by bare name at any depth. This is a public repository:
# verify with `git check-ignore -v sites/auth.bythewood.me/.env`.
#
# There is no password here. This site has no password to have: signing in is a
# code pushed to a phone, and the break-glass is a recovery code that only ever
# exists as an Argon2id hash on disk.

# Write-only ntfy token for the auth topic, minted by `make ntfy-token`. It is
# its own token and its own topic, because the one in status' and logging' .env
# files can publish to their topics, and a copy of either would otherwise be
# able to mint its own login codes.
#
# Unset means codes cannot be delivered and only recovery codes work. The site
# still starts, since refusing to would turn a missing alert credential into
# being locked out of every site at once.
AUTH_NTFY_TOKEN=

# The cookie domain, which is what makes one login cover every bythewood.me
# host. Leave it empty for development on localhost, where a cookie scoped to
# the parent domain is simply never sent and the login appears to work and then
# does not stick.
SESSION_DOMAIN=.bythewood.me
