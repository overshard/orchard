# The pepper every pond key is hashed under before it is stored. Fill it once
# with `openssl rand -hex 32` and keep a copy somewhere safe, since changing or
# losing it locks every frog out for good.
POND_PEPPER=

# A key for the model gateway, from `make llm-key NAME=pond` at the root. Left
# empty the nightly lines are off and the frogs use the hand written ones.
LLM_KEY=
