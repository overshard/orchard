# true only while making the one account, then false and deploy again. The
# page warns the whole time it's on.
PASS_SIGNUPS=false

# Optional, for instant sync on the phone. An id and key from
# bitwarden.com/host, whose push relay carries a wake up and nothing from the vault.
PASS_PUSH_ENABLED=false
PASS_PUSH_INSTALLATION_ID=
PASS_PUSH_INSTALLATION_KEY=

# Publishes failed sign ins, new devices and new Vaultwarden releases to the
# alerts topic. `make ntfy-token` mints it. Without it they're only logged.
NTFY_TOKEN=

# Sent with every batch of log records shipped to logging.bythewood.me, which
# refuses a batch without it. The same value is in every .env, and `make
# logging-token` writes it.
LOGGING_TOKEN=
