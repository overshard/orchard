// Eight independent modules. This file exists so `go build ./...`, `go vet ./...`
// and `go test ./...` work from the repo root and an editor resolves all eight
// at once.
//
// Nothing depends on it. Each site builds on its own from its own directory,
// and its Docker build context is that directory alone, so a site can be moved
// to its own repository by copying the folder.
go 1.27.0

use (
	./sites/analytics.bythewood.me
	./sites/auth.bythewood.me
	./sites/blog.bythewood.me
	./sites/dash.bythewood.me
	./sites/isaacbythewood.com
	./sites/logging.bythewood.me
	./sites/repos.bythewood.me
	./sites/search.bythewood.me
	./sites/status.bythewood.me
)
