# Build output. dist/ is regenerated by Vite and copied into the image; it is
# not source, and committing content-hashed filenames would churn every build.
dist/
bin/
node_modules/

# `go build .` inside a site directory writes an executable named after that
# directory, which is how a 14MB binary got committed on day one. `make build`
# uses -o bin/ and avoids this, but the bare command is the one people type.
/sites/*/isaacbythewood.com
/sites/*/*.com
!/sites/*.com/

# Playwright scratch
.playwright-cli/

# Tunnel credentials never touch the repo: they live in the named volume that
# setup-tunnel.sh creates.
credentials.json
cert.pem
*.pem
.env
